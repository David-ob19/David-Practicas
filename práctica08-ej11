#include <iostream>
#include <conio.h>

using namespace std;

void leerVector(float v[], int n);
void mostrarVector(float v[], int n);
void clasificarElementos(float v[], int n, int &pos, int &neg, int &ceros);

int main() {
    int n;

    cout << "Ingrese la cantidad de elementos (n > 0): ";
    cin >> n;

    if (n <= 0) {
        cout << "El tamano debe ser mayor a 0." << endl;
    } else {
        float A[100];
        int pos = 0;
        int neg = 0;
        int ceros = 0;

        leerVector(A, n);

        cout << endl;
        cout << "--- Vector Ingresado ---" << endl;
        mostrarVector(A, n);

        clasificarElementos(A, n, pos, neg, ceros);

        cout << endl;
        cout << "Cantidad de elementos positivos: " << pos << endl;
        cout << "Cantidad de elementos negativos: " << neg << endl;
        cout << "Cantidad de elementos iguales a cero: " << ceros << endl;
    }

    getch();
    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "Ingrese el elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "v[" << i << "] = " << v[i] << endl;
    }
}

void clasificarElementos(float v[], int n, int &pos, int &neg, int &ceros) {
    pos = 0;
    neg = 0;
    ceros = 0;

    for (int i = 0; i < n; i = i + 1) {
        if (v[i] > 0) {
            pos = pos + 1;
        } else if (v[i] < 0) {
            neg = neg + 1;
        } else {
            ceros = ceros + 1;
        }
    }
}
