#include <iostream>
#include <cmath>

using namespace std;

void leerCoeficientes(float &a, float &b, float &c) {
    do {
        cout << "Ingrese el coeficiente a (a != 0): ";
        cin >> a;
        if (a == 0) {
            cout << "El valor de 'a' no puede ser 0 para una ecuacion cuadratica.\n" << endl;
        }
    } while (a == 0);

    cout << "Ingrese el coeficiente b: ";
    cin >> b;
    cout << "Ingrese el coeficiente c: ";
    cin >> c;
}

void resolverEcuacion(float a, float b, float c) {
    float discriminante = (b * b) - (4 * a * c);

    if (discriminante > 0) {
        float x1 = (-b + sqrt(discriminante)) / (2 * a);
        float x2 = (-b - sqrt(discriminante)) / (2 * a);
        cout << "\nLas soluciones reales son:" << endl;
        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;
    } else if (discriminante == 0) {
        float x = -b / (2 * a);
        cout << "\nExiste una unica solucion real:" << endl;
        cout << "x1 = x2 = " << x << endl;
    } else {
        cout << "\nLa ecuacion no tiene soluciones reales (discriminante negativo)." << endl;
    }
}

int main() {
    float a, b, c;

    leerCoeficientes(a, b, c);
    resolverEcuacion(a, b, c);

    return 0;
}
