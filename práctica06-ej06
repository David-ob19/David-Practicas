#include <iostream>
#include <cmath>

using namespace std;

void pedirCoeficientes(float &a, float &b, float &c) {
    cout << "Ingrese a: ";
    cin >> a;
    cout << "Ingrese b: ";
    cin >> b;
    cout << "Ingrese c: ";
    cin >> c;
}

void resolverEcuacion(float a, float b, float c) {
    if (a == 0 && b == 0 && c == 0) {
        cout << "La ecuacion tiene infinitas soluciones." << endl;
    } 
    else if (a == 0 && b == 0) {
        cout << "La ecuacion no tiene solucion (inconsistente)." << endl;
    } 
    else if (a == 0) {
        float x = -c / b;
        cout << "Es una ecuacion lineal. Solucion unica: x = " << x << endl;
    } 
    else {
        float d = (b * b) - (4 * a * c);

        if (d > 0) {
            float x1 = (-b + sqrt(d)) / (2 * a);
            float x2 = (-b - sqrt(d)) / (2 * a);
            cout << "Dos soluciones reales distintas:" << endl;
            cout << "x1 = " << x1 << endl;
            cout << "x2 = " << x2 << endl;
        } 
        else if (d == 0) {
            float x = -b / (2 * a);
            cout << "Una solucion real doble: x = " << x << endl;
        } 
        else {
            cout << "No tiene soluciones reales (las soluciones son complejas)." << endl;
        }
    }
}

int main() {
    float a, b, c;

    pedirCoeficientes(a, b, c);
    resolverEcuacion(a, b, c);

    return 0;
}
