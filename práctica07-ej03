#include <iostream>
#include <cmath>

using namespace std;

float POTEN(float x, float y) {
    return pow(x, y);
}

long long FAC(int n) {
    long long fact = 1;
    for (int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

int main() {
    float x;
    int n;

    cout << "Ingrese el valor de X: ";
    cin >> x;
    cout << "Ingrese el valor de N (entero positivo): ";
    cin >> n;

    if (n <= 0) {
        cout << "N debe ser un entero positivo mayor a 0." << endl;
    } else {
        float suma = 0;
        for (int i = 1; i <= n; i++) {
            suma += POTEN(x, i) / FAC(i);
        }

        cout << "La suma de la serie es: " << suma << endl;
    }

    return 0;
}
