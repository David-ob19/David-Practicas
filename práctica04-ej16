#include <iostream>

using namespace std;

int main() {
    int n, divisores = 0;

    cout << "Ingrese N: ";
    cin >> n;

    if (n <= 1) {
        cout << n << " no es primo." << endl;
    } else {
        for (int i = 1; i <= n; i++) {
            if (n % i == 0) {
                divisores++;
            }
        }

        switch (divisores) {
            case 2:
                cout << n << " es primo." << endl;
                break;
            default:
                cout << n << " no es primo." << endl;
                break;
        }
    }

    return 0;
}
