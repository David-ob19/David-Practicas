#include <iostream>

using namespace std;

int main() {
	for (int h = 0; h < 24; h++) {
		for (int m = 0; m < 60; m++) {
			for (int s = 0; s < 60; s++) {
				// Formato de horas HH
				if (h < 10) cout << "0";
				cout << h << ":";

				// Formato de minutos MM
				if (m < 10) cout << "0";
				cout << m << ":";

				// Formato de segundos SS
				if (s < 10) cout << "0";
				cout << s << endl;
			}
		}
	}

	return 0;
}
