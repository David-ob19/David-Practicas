#include <iostream>

using namespace std;

int main() {
    int n;
    double x, suma = 0.0, potencia = 1.0;
    long long factorial = 1;

    cout << "Ingrese X y N : ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        potencia *= x;
        factorial *= i;
        suma += potencia / factorial;
    }

    cout << "S = " << suma << endl;

    return 0;
}
