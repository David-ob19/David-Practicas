#include <iostream>

using namespace std;

int main() {
    int C, N, M, G;
    double T;

    cout << "Ingrese el capital inicial C: ";
    cin >> C;

    cout << "Ingrese la tasa de interes anual: ";
    cin >> T;

    cout << "Ingrese el plazo en anos N: ";
    cin >> N;

    M = (int)(C * pow(1 + (T / 1200.0), N * 12));
    G = M - C;

    cout << "Monto acumulado M: " << M << endl;
    cout << "Ganancia neta G: " << G << endl;

    return 0;
}
