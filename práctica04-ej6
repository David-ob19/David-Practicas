#include <iostream>

using namespace std;

int main() {
    int n;
    double x, suma = 0.0, termino = 1.0;

    cout << "Ingrese X (real) y N (entero): ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        termino *= x;
        suma += termino;
    }

    cout << "S = " << suma << endl;

    return 0;
}
