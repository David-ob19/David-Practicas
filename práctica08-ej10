#include <iostream>
#include <conio.h>

using namespace std;

void leerVector(float v[], int tam);
void mostrarVector(float v[], int tam);
void intercalarOrdenados(float A[], int n, float B[], int m, float C[]);

int main() {
    int n, m;

    cout << "Ingrese la cantidad de elementos del vector A (n > 0): ";
    cin >> n;
    cout << "Ingrese la cantidad de elementos del vector B (m > 0): ";
    cin >> m;

    if (n <= 0 || m <= 0) {
        cout << "Los tamanos deben ser mayores a 0." << endl;
    } else {
        float A[100];
        float B[100];
        float C[200];

        cout << endl;
        cout << "--- Carga del Vector A (ordenado ascendentemente) ---" << endl;
        leerVector(A, n);

        cout << endl;
        cout << "--- Carga del Vector B (ordenado ascendentemente) ---" << endl;
        leerVector(B, m);

        intercalarOrdenados(A, n, B, m, C);

        cout << endl;
        cout << "--- Vector A ---" << endl;
        mostrarVector(A, n);

        cout << endl;
        cout << "--- Vector B ---" << endl;
        mostrarVector(B, m);

        cout << endl;
        cout << "--- Vector C (Intercalado y Ordenado) ---" << endl;
        mostrarVector(C, n + m);
    }

    getch();
    return 0;
}

void leerVector(float v[], int tam) {
    for (int i = 0; i < tam; i = i + 1) {
        cout << "Ingrese el elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(float v[], int tam) {
    for (int i = 0; i < tam; i = i + 1) {
        cout << "v[" << i << "] = " << v[i] << endl;
    }
}

void intercalarOrdenados(float A[], int n, float B[], int m, float C[]) {
    int i = 0;
    int j = 0;
    int k = 0;

    while (i < n && j < m) {
        if (A[i] <= B[j]) {
            C[k] = A[i];
            i = i + 1;
        } else {
            C[k] = B[j];
            j = j + 1;
        }
        k = k + 1;
    }

    while (i < n) {
        C[k] = A[i];
        i = i + 1;
        k = k + 1;
    }

    while (j < m) {
        C[k] = B[j];
        j = j + 1;
        k = k + 1;
    }
}
