#include <iostream>

using namespace std;

int main() {
    int n;
    double x, suma = 0.0, potencia = 1.0;
    long long factorial = 1;

    cout << "Ingrese X (real) y N (entero): ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        potencia *= x;
        factorial *= i;

        if (i % 2 != 0) {
            suma += potencia / factorial;
        } else {
            suma -= potencia / factorial;
        }
    }

    cout << "S = " << suma << endl;

    return 0;
}
