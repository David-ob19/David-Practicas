#include <iostream>
#include <string>

using namespace std;

void convertirARomano(int n) {
    if (n <= 0 || n > 3999) {
        cout << "Numero fuera de rango (debe ser entre 1 y 3999)." << endl;
        return;
    }

    int valores[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    string romanos[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};

    string resultado = "";

    for (int i = 0; i < 13; i++) {
        while (n >= valores[i]) {
            resultado += romanos[i];
            n -= valores[i];
        }
    }

    cout << "Equivalente en romano: " << resultado << endl;
}

int main() {
    int n;

    cout << "Ingrese un numero entero: ";
    cin >> n;

    convertirARomano(n);

    return 0;
}
