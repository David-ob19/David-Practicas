#include <iostream>
#include <conio.h>

using namespace std;

void leerVector(float v[], int n);
void mostrarVector(float v[], int n);
float calcularPromedio(float v[], int n);

int main() {
    int n;

    cout << "Ingrese la cantidad de elementos (n > 0): ";
    cin >> n;

    if (n <= 0) {
        cout << "El tamano debe ser mayor a 0." << endl;
    } else {
        float A[100];

        leerVector(A, n);
        
        cout << endl;
        cout << "--- Vector Ingresado ---" << endl;
        mostrarVector(A, n);

        float promedio = calcularPromedio(A, n);
        cout << endl;
        cout << "El promedio de los elementos es: " << promedio << endl;
    }

    getch();
    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "Ingrese el elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "v[" << i << "] = " << v[i] << endl;
    }
}

float calcularPromedio(float v[], int n) {
    float suma = 0.0;

    for (int i = 0; i < n; i = i + 1) {
        suma = suma + v[i];
    }

    return suma / n;
}
