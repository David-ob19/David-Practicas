#include <iostream>
#include <conio.h>

using namespace std;

void leerVector(float v[], int n);
void mostrarVector(float v[], int n);
void invertirEnSitio(float A[], int n);

int main() {
    int n;

    cout << "Ingrese la cantidad de elementos (n > 0): ";
    cin >> n;

    if (n <= 0) {
        cout << "El tamano debe ser mayor a 0." << endl;
    } else {
        float A[100];

        leerVector(A, n);

        cout << endl;
        cout << "--- Vector Original ---" << endl;
        mostrarVector(A, n);

        invertirEnSitio(A, n);

        cout << endl;
        cout << "--- Vector Invertido en el Mismo Arreglo ---" << endl;
        mostrarVector(A, n);
    }

    getch();
    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "Ingrese el elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "v[" << i << "] = " << v[i] << endl;
    }
}

void invertirEnSitio(float A[], int n) {
    for (int i = 0; i < n / 2; i = i + 1) {
        float aux = A[i];
        A[i] = A[n - 1 - i];
        A[n - 1 - i] = aux;
    }
}
