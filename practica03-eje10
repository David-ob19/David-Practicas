#include <iostream>

using namespace std;

int main() {
    int d1, m1, d2, m2;
    int totalDias1, totalDias2, diffDias;
    int meses, dias;

    cout << "Ingrese la fecha inicial (DD MM): ";
    cin >> d1 >> m1;

    cout << "Ingrese la fecha final (DD MM): ";
    cin >> d2 >> m2;

    totalDias1 = (m1 * 30) + d1;
    totalDias2 = (m2 * 30) + d2;

    diffDias = totalDias2 - totalDias1;

    meses = diffDias / 30;
    dias = diffDias % 30;

    cout << "Diferencia: " << meses << " meses " << dias << " dias" << endl;

    return 0;
}
