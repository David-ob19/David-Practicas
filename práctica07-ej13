#include <iostream>
#include <cmath>

using namespace std;

float redondear(float R, int n) {
    float factor = pow(10, n);
    return round(R * factor) / factor;
}

int main() {
    float R;
    int n;

    cout << "Ingrese el numero real R: ";
    cin >> R;
    cout << "Ingrese la cantidad de decimales n: ";
    cin >> n;

    float resultado = redondear(R, n);

    cout << "El numero redondeado es: " << resultado << endl;

    return 0;
}
