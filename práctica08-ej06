#include <iostream>
#include <conio.h>

using namespace std;

void leerVector(float v[], int n);
void mostrarVector(float v[], int n);
void calcularPromediosConsecutivos(float A[], float B[], int n);

int main() {
    int n;

    cout << "Ingrese la cantidad de elementos (n >= 3): ";
    cin >> n;

    if (n < 3) {
        cout << "El tamano debe ser mayor o igual a 3." << endl;
    } else {
        float A[100];
        float B[100];

        leerVector(A, n);

        calcularPromediosConsecutivos(A, B, n);

        cout << endl;
        cout << "--- Vector Original (A) ---" << endl;
        mostrarVector(A, n);

        cout << endl;
        cout << "--- Vector de Promedios Consecutivos (B) ---" << endl;
        mostrarVector(B, n - 2);
    }

    getch();
    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "Ingrese el elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void mostrarVector(float v[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        cout << "v[" << i << "] = " << v[i] << endl;
    }
}

void calcularPromediosConsecutivos(float A[], float B[], int n) {
    for (int i = 0; i < n - 2; i = i + 1) {
        B[i] = (A[i] + A[i + 1] + A[i + 2]) / 3.0;
    }
}
