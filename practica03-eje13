#include <iostream>

using namespace std;

int main() {
    int a, b, c;
    int d, x1, x2, real, imag;

    cout << "Ingrese a; b; c: ";
    cin >> a >> b >> c;

    if (a == 0 && b == 0) {
        cout << "Ecuacion degenerada" << endl;
    } else if (a == 0 && b != 0) {
        x1 = -c / b;
        cout << "Ecuacion lineal, x = " << x1 << endl;
    } else {
        d = (b * b) - (4 * a * c);

        if (d > 0) {
            x1 = (int)((-b + sqrt(d)) / (2 * a));
            x2 = (int)((-b - sqrt(d)) / (2 * a));
            cout << "Dos raices reales: x1 = " << x1 << ", x2 = " << x2 << endl;
        } else if (d == 0) {
            x1 = -b / (2 * a);
            cout << "Raiz real doble: x = " << x1 << endl;
        } else {
            real = -b / (2 * a);
            imag = (int)(sqrt(-d) / (2 * a));
            cout << "Raices complejas: " << real << " + " << imag << "i y " << real << " - " << imag << "i" << endl;
        }
    }

    return 0;
}
